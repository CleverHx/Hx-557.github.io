# Public domain that points to this server, for example: blog.example.com
SITE_DOMAIN=blog.example.com

# Optional email for Let's Encrypt certificate notices
ACME_EMAIL=you@example.com

# WordPress database settings
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=change-me-wordpress-password
MARIADB_ROOT_PASSWORD=change-me-root-password

# Keep production for public deployments
WP_ENVIRONMENT_TYPE=production

# Optional: only needed if you use the cloudflare-tunnel compose profile
CLOUDFLARE_TUNNEL_TOKEN=
